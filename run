#!/usr/bin/env bash
# ./run — one command to start darkcat.
#
#   ./run [args]          darkcat
#
#   First run creates .venv and installs the package editable
#   (uv when available, else python3 -m venv + pip); later runs skip it.
#   A .venv whose python no longer runs is rebuilt; a missing install is redone.
#
#   RUN_MODE=deps ./run    install dependencies and exit (what make runs)
#   RUN_MODE=check ./run   verify the python3 toolchain is present
#
# Everything is relative to this file, so it works from any directory.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

VENV=".venv"
ensure_deps() {
    if ! "$VENV/bin/python" -c pass >/dev/null 2>&1; then
        if [ -e "$VENV" ]; then
            echo "· $VENV cannot run its python (moved or half-built) — rebuilding it…" >&2
            rm -rf "$VENV"
        fi
        echo "· creating $VENV (first run only)…" >&2
        if command -v uv >/dev/null 2>&1; then
            uv venv "$VENV"
        else
            python3 -m venv "$VENV"
            "$VENV/bin/pip" install -q --upgrade pip
        fi
    fi
    if ! [ -x "$VENV/bin/darkcat" ]; then
        echo "· installing the package into $VENV…" >&2
        if command -v uv >/dev/null 2>&1; then
            VIRTUAL_ENV="$PWD/$VENV" uv pip install -e .
        else
            [ -x "$VENV/bin/pip" ] || "$VENV/bin/python" -m ensurepip -q
            "$VENV/bin/pip" install -q -e .
        fi
    fi
}
run_check() {
    command -v python3 >/dev/null 2>&1 || {
        echo "✗ python3 not found — install Python 3 first (python3 / python3-venv packages)" >&2
        exit 1
    }
    if ! command -v uv >/dev/null 2>&1; then
        python3 -c "import venv, ensurepip" >/dev/null 2>&1 || {
            echo "✗ neither uv nor python3-venv is available — install python3-venv (dnf/apt) or uv (https://docs.astral.sh/uv/)" >&2
            exit 1
        }
    fi
    echo "· toolchain OK (python3$(command -v uv >/dev/null 2>&1 && echo ' + uv'))" >&2
}
case "${RUN_MODE:-}" in
    deps)  ensure_deps; echo "· dependencies ready ($VENV)" >&2; exit 0 ;;
    check) run_check; exit 0 ;;
esac
case "${1:-}" in
    help|-h|--help) grep '^#' "$0" | sed -E '1d; s/^# ?//'; exit 0 ;;
esac
ensure_deps

CMD="darkcat"

exec "$VENV/bin/$CMD" "$@"
